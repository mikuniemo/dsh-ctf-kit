{
  "name": "@local/dsh-ctf-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CTF 题板：会话视图栏新增 CTF 独立视图，一题一卡展示 flag / 题解 / 错误 / 踩坑，数据取自 D:\\DSH_HOME\\ctf 题卡目录",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
